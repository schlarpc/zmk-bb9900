config BOARD_BB9900
    select SOC_NRF52840_QIAA
    select ZMK_BOARD_COMPAT if BOARD_BB9900_NRF52840_ZMK
    imply RETAINED_MEM if BOARD_BB9900_NRF52840_ZMK
    imply RETENTION if BOARD_BB9900_NRF52840_ZMK
    imply RETENTION_BOOT_MODE if BOARD_BB9900_NRF52840_ZMK

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>

#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/hid_indicators.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

#include "bb9900-pinctrl.dtsi"

/ {
    model = "bb9900";
    compatible = "zitaotech,bb9900";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,battery = &vbatt;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,backlight = &backlight;
        zitaotech,layer-indicator = &layer_indicator_leds;
        zitaotech,capslock-indicator = &capslock_indicator_leds;
    };

    // Big button backlight, used as the layer indicator.
    layer_indicator_leds: layer_indicator_leds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };

    // Trackpad backlight, used as the caps lock indicator.
    capslock_indicator_leds: capslock_indicator_leds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm2 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };

    backlight: backlight {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm1 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        };
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <7>;
        map = <
RC(6,1)                                                                   RC(6,0)
RC(2,0)          RC(4,0)             RC(0,0)             RC(5,0)          RC(3,0)
RC(1,1)  RC(0,1) RC(1,3) RC(1,2) RC(4,2) RC(4,5) RC(1,5) RC(4,4) RC(1,4)  RC(6,3)
RC(1,0)  RC(0,3) RC(4,3) RC(2,2) RC(0,2) RC(0,5) RC(2,5) RC(2,4) RC(0,4)  RC(6,4)
RC(5,1)  RC(3,3) RC(5,3) RC(3,2) RC(5,2) RC(5,5) RC(3,5) RC(3,4) RC(5,4)  RC(6,5)
RC(2,3)          RC(2,1)             RC(3,1)             RC(4,1)          RC(6,2)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        debounce-press-ms = <10>;
        debounce-release-ms = <10>;
        row-gpios
            = <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&gpio1 11 GPIO_ACTIVE_HIGH>
            , <&gpio1 6  GPIO_ACTIVE_HIGH>
            , <&gpio1 4  GPIO_ACTIVE_HIGH>
            , <&gpio0 17 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            , <&gpio0 24 GPIO_ACTIVE_HIGH>
            ;
    };

    // Node name must match original "EXT_POWER" label to preserve user settings.
    ext_power_supply: EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 2>;
        output-ohms = <2000000>;
        full-ohms = <(2000000 + 820000)>;
    };

    // Trackpad mode switches to scrolling while the host has caps lock or scroll lock on.
    indicator_scroll: indicator_scroll {
        compatible = "zitaotech,input-processor-indicator-scroll";
        #input-processor-cells = <0>;
        indicators = <(HID_INDICATOR_CAPS_LOCK | HID_INDICATOR_SCROLL_LOCK)>;
        interval-ms = <30>;
    };

    // The sensor is mounted rotated, so swap the axes before anything else. The 3/2 scaler
    // matches the original firmware's 1.5x pointer speed; override input-processors in your
    // keymap to change it.
    trackpad_listener: trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,
                           <&indicator_scroll>,
                           <&zip_xy_scaler 3 2>;
    };
};

// P0.09 and P0.10 drive the keyboard and trackpad backlights.
&uicr {
    nfct-pins-as-gpios;
};

&reg1 {
    regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    trackpad: a320@3b {
        compatible = "avago,a320";
        reg = <0x3b>;
        polling-interval-ms = <10>;
        motion-polling-interval-ms = <2>;
        ext-power = <&ext_power_supply>;
        speed-switching;
        assert-deassert;
        finger-detect;
        // Tuned from traces: thumb swipes peak at 4-8 inches per second, well under the sensor
        // defaults, so step up through 750/1000/1250 CPI at 2, 3 and 4 ips.
        //                   ST12 ST21 ST23 ST32 ST34 ST43 ST45 ST54
        speed-thresholds = [  08   06   10   0c   18   14   20   1c ];
        high-cpi;
        // Tracking shutter values sit around 140-230 and jump well above that as the finger lifts.
        // High-shutter samples that continue a fast stroke are still reported.
        liftoff-shutter-threshold = <240>;
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_default>;
    pinctrl-1 = <&pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};

&pwm2 {
    status = "okay";
    pinctrl-0 = <&pwm2_default>;
    pinctrl-1 = <&pwm2_sleep>;
    pinctrl-names = "default", "sleep";
};

zephyr_udc0: &usbd {
    status = "okay";
};

&flash0 {
    /*
     * For more information, see:
     * http://docs.zephyrproject.org/latest/devices/dts/flash_partitions.html
     */
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00001000>;
        };

        code_partition: partition@1000 {
            reg = <0x00001000 0x000d3000>;
        };

        /*
         * The flash starting at 0x000d4000 and ending at
         * 0x000f3fff is reserved for use by the application.
         */

        /*
         * Storage partition will be used by FCB/LittleFS/NVS
         * if enabled.
         */
        storage_partition: partition@d4000 {
            reg = <0x000d4000 0x00020000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/input_transform.h>

#define BASE 0
#define SYM 1
#define UPPER 2
#define SCROLL 3  // Keep in sync with CONFIG_ZMK_BB9900_TRACKPAD_INDICATOR_LAYER.

// Key positions used by combos.
#define POS_ALT 27
#define POS_LEFT_AA 37
#define POS_RIGHT_AA 41

// Modifiers and layers are sticky, BlackBerry style: tap applies to the next key, hold works
// as normal. Give up after 2 s instead of the default 1 s.
//
// The double-tap window (tapping-term-ms on the tap dances below) counts from the first press.
// aA presses are also held back by the alt + aA combo for up to its timeout, so keep the window
// generous: a single tap still resolves as soon as the next key is pressed.
//
// Layer keys: SYM taps for one key, holds for momentary and double-taps to lock; alt + aA
// toggles UPPER on tap and holds for momentary. In a locked SYM, SYM returns to BASE; in UPPER,
// SYM switches to SYM.
&sk {
    release-after-ms = <2000>;
    quick-release;
};

&sl {
    release-after-ms = <2000>;
};

/ {
    behaviors {
        // Trackpad click; double-tap clears the current BT profile.
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };

        // Tap: USB/BLE output toggle when held, space when tapped.
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&out &kp>;
        };

        // Call: tap to toggle scroll mode, hold to scroll while held.
        scroll_mode: scroll_mode {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&tog>;
        };

        // aA: tap for one capital, hold for Shift, double-tap for caps word.
        td_shift: tap_dance_shift {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&sk LSHFT>, <&caps_word>;
        };

        // SYM: tap for one key from SYM, hold for SYM, double-tap to lock it.
        td_sym: tap_dance_sym {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&sl SYM>, <&to SYM>;
        };

        // alt + aA: tap to toggle UPPER, hold for UPPER while held. A tap dance cannot be
        // double-tapped reliably through a combo: the second combo's key presses settle the
        // dance early as a single tap.
        upper_mode: upper_mode {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    combos {
        compatible = "zmk,combos";

        upper_left {
            timeout-ms = <50>;
            key-positions = <POS_ALT POS_LEFT_AA>;
            bindings = <&upper_mode UPPER UPPER>;
        };

        upper_right {
            timeout-ms = <50>;
            key-positions = <POS_ALT POS_RIGHT_AA>;
            bindings = <&upper_mode UPPER UPPER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
//         --------------------------------------------------------------------------------------------------------------------------
//         |    Shoulder Key1    |                                                                             |    Shoulder Key2    |
// |         Call key      |      Blackberry Key        |    Trackpad    |             Back Key                |             Endcall Key          |
// |     Q      |     W    |     E    |     R    |      T      |       Y        |       U        |        I        |       O      |      P        |
// |     A      |     S    |     D    |     F    |      G      |       H        |       J        |        K        |       L      |      ←        |
// |     alt    |     Z    |     X    |     C    |      V      |       B        |       N        |        M        |       $      |    Enter      |
//        |         aA     |         0           |           SPACE              |         SYM         |        aA          |
//        -----------------------------------------------------------------------------------------------------------------
// alt + aA (either) = UPPER

                 &mkp LCLK                                                                                          &mkp RCLK
    &scroll_mode SCROLL SCROLL &kp LGUI                         &mkp LCLK                          &mt ESC K_BACK                    &kp TAB
    &kp Q        &kp W      &kp E       &kp R     &kp T         &kp Y             &kp U            &kp I            &kp O            &kp P
    &kp A        &kp S      &kp D       &kp F     &kp G         &kp H             &kp J            &kp K            &kp L            &kp BSPC
    &sk LALT     &kp Z      &kp X       &kp C     &kp V         &kp B             &kp N            &kp M            &kp DLLR         &kp ENTER
    &td_shift               &sk LCTRL                           &kp SPACE                          &td_sym                           &td_shift
            >;
        };

        // The legends printed on the keys.
        sym_layer {
            display-name = "SYM";
            bindings = <
                 &kp C_VOL_UP                                                                                       &kp C_VOL_DN
    &kp PSCRN               &kp C_AC_SEARCH                     &mkp LCLK                          &kp F5                            &kp F12
    &kp HASH     &kp N1     &kp N2      &kp N3    &mt LBKT LPAR &mt RBKT RPAR     &kp UNDER        &kp MINUS        &kp PLUS         &kp AT
    &kp STAR     &kp N4     &kp N5      &kp N6    &kp SLASH     &kp COLON         &kp SEMI         &kp APOS         &kp DQT          &kp DEL
    &trans       &kp N7     &kp N8      &kp N9    &kp QMARK     &kp EXCL          &kp COMMA        &kp DOT          &kp C_MUTE       &kp ENTER
    &trans                  &kp N0                              &kp SPACE                          &to BASE                          &trans
            >;
        };

        // Bluetooth, navigation, extra symbols and system controls.
        upper_layer {
            display-name = "UPPER";
            bindings = <
                 &msc SCRL_UP                                                                                       &msc SCRL_DOWN
    &bt BT_SEL 0            &bt BT_SEL 1                             &td0                           &bt BT_SEL 2                     &bt BT_SEL 3
    &kp CLCK     &kp UP     &none       &sys_reset &kp LT        &kp GT            &ext_power EP_TOG &none          &kp PIPE         &kp EQUAL
    &kp LEFT     &kp DOWN   &kp RIGHT   &none      &kp BSLH      &kp AMPS          &kp LBRC         &kp RBRC        &kp CARET        &kp BSPC
    &trans       &none      &none       &none      &bl BL_DEC    &bl BL_TOG        &bl BL_INC       &none           &bootloader      &kp ENTER
    &trans                  &trans                                   &hm OUT_TOG SPACE              &to SYM                          &trans
            >;
        };

        // Scroll mode: keys pass through, and the trackpad scrolls instead of moving the pointer.
        scroll_layer {
            display-name = "SCROLL";
            bindings = <
                 &trans                                                                                             &trans
    &trans                  &trans                              &trans                             &trans                            &trans
    &trans       &trans     &trans      &trans    &trans        &trans            &trans           &trans           &trans           &trans
    &trans       &trans     &trans      &trans    &trans        &trans            &trans           &trans           &trans           &trans
    &trans       &trans     &trans      &trans    &trans        &trans            &trans           &trans           &trans           &trans
    &trans                  &trans                              &trans                             &trans                            &trans
            >;
        };
    };
};

// In scroll mode the trackpad goes through the scroll curve instead of the pointer scaler.
// Tune the curve with knee, low-gain and high-gain on &scroll_curve (see its binding).
&trackpad_listener {
    scroll_mode {
        layers = <SCROLL>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,
                           <&scroll_curve>;
    };
};

// Pointer speed. Uncomment and edit to override the board default: <&zip_xy_scaler 3 2> is a
// fraction (3/2 = 1.5x); use <&zip_x_scaler ...> and <&zip_y_scaler ...> for separate horizontal
// and vertical speeds.
//
// &trackpad_listener {
//     input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,
//                        <&zip_xy_scaler 3 2>;
// };
//
// Scroll speed:
//
// &scroll_curve {
//     knee = <6>;
//     low-gain = <34>;
//     high-gain = <3>;
// };
